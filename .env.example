# ─────────────────────────────────────────────────────────────
#  Copy this file to ".env" and fill it in. Never commit ".env".
#  Only variables starting with VITE_ ever reach the browser —
#  never give a secret a VITE_ name.
# ─────────────────────────────────────────────────────────────

# ── Admin account (required to use /admin) ──
ADMIN_EMAIL=you@example.com
# Generate with:  npm run admin:password   (paste the whole line it prints)
ADMIN_PASSWORD_HASH=
# How long a login lasts, in hours (1–72)
SESSION_HOURS=8

# ── Storage ──
# "file"     = saves in server/data on this computer (development only)
# "supabase" = database + image storage that survives redeploys (production)
STORAGE_DRIVER=file
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase → Project Settings → API Keys → "secret" key (or the legacy service_role key). Server only!
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=portfolio
# Private bucket for downloadable PDFs (given only after the lead form)
SUPABASE_PRIVATE_BUCKET=portfolio-private

# Max image upload size in MB
MAX_UPLOAD_MB=5
# Max PDF upload size in MB (CV, e-books)
MAX_PDF_MB=20

# ── Free PDF downloads ──
# Secret used to sign the temporary download links (any long random text).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# If empty, the server creates one and keeps it in storage.
DOWNLOAD_SECRET=

# ── Booking calendar (optional, read-only list of appointments in the dashboard) ──
# Calendly → Integrations → API & Webhooks → Personal access token
CALENDLY_TOKEN=
# Cal.com → Settings → Developer → API keys
CALCOM_API_KEY=

# ── Hosting ──
PORT=8787
# Set to true when the site runs behind a proxy/load balancer (Render, Railway, Fly, nginx)
TRUST_PROXY=false
# Secure cookies are on automatically when NODE_ENV=production
# COOKIE_SECURE=true
# Only if you keep file storage on a persistent disk in production (VPS / Render disk):
# ALLOW_FILE_STORAGE_IN_PRODUCTION=true
# DATA_DIR=/var/data/nourhane

# ── Contact form ──
# Nothing to configure: messages are stored by this server (same storage as the content)
# and appear in the dashboard → Messages.

# ── Arabic heading font (optional) ──
# Set to "bukra" only after adding the licensed 29LT Bukra web-font files to
# public/fonts/bukra/ (see public/fonts/README.txt). Otherwise Tajawal is used.
VITE_ARABIC_HEADING_FONT=

# ── Read-only reports in the dashboard (optional) ──
# Google Analytics 4 + Search Console: a Google Cloud service account (JSON, or the JSON in base64).
# Add its e-mail as a Viewer of the GA4 property and as a user of the Search Console property.
GOOGLE_SERVICE_ACCOUNT_JSON=
GA4_PROPERTY_ID=
# Exactly as in Search Console, e.g. https://nourhanethabet.com/ or sc-domain:nourhanethabet.com
GSC_SITE_URL=
# Google Ads API (read-only reports): approved developer token + OAuth client + refresh token
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# Only if the account is managed through a manager (MCC) account
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v21
# Meta Marketing API (read-only insights): system-user token with ads_read + ad account id (act_…)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_API_VERSION=v21.0

# ── AI marketing assistant (optional; drafts only) ──
# AI_PROVIDER=anthropic or openai
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
