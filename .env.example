# ─────────────────────────────────────────────────────────────
#  Copy this file to ".env" and fill it in. Never commit ".env".
#  Only variables starting with VITE_ ever reach the browser —
#  never give a secret a VITE_ name.
# ─────────────────────────────────────────────────────────────

# ── Admin account (required to use /admin) ──
ADMIN_EMAIL=you@example.com
# Generate with:  npm run admin:password   (paste the whole line it prints)
ADMIN_PASSWORD_HASH=
# How long a login lasts, in hours (1–72)
SESSION_HOURS=8

# ── Storage ──
# "file"     = saves in server/data on this computer (development only)
# "supabase" = database + image storage that survives redeploys (production)
STORAGE_DRIVER=file
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase → Project Settings → API Keys → "secret" key (or the legacy service_role key). Server only!
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=portfolio

# Max image upload size in MB
MAX_UPLOAD_MB=5

# ── Hosting ──
PORT=8787
# Set to true when the site runs behind a proxy/load balancer (Render, Railway, Fly, nginx)
TRUST_PROXY=false
# Secure cookies are on automatically when NODE_ENV=production
# COOKIE_SECURE=true
# Only if you keep file storage on a persistent disk in production (VPS / Render disk):
# ALLOW_FILE_STORAGE_IN_PRODUCTION=true
# DATA_DIR=/var/data/nourhane

# ── Contact form ──
# Nothing to configure: messages are stored by this server (same storage as the content)
# and appear in the dashboard → Messages.

# ── Arabic heading font (optional) ──
# Set to "bukra" only after adding the licensed 29LT Bukra web-font files to
# public/fonts/bukra/ (see public/fonts/README.txt). Otherwise Tajawal is used.
VITE_ARABIC_HEADING_FONT=
